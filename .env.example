# Required in production. Never commit real values.
BRAD_OS_PASSWORD=change-me-to-a-long-passphrase
SESSION_SECRET=generate-with-openssl-rand-hex-32
# Where the SQLite database lives (mount a Railway volume here)
DATA_DIR=./data
# Seed made-up sample records on first run (true/false)
SEED_SAMPLE=true
PORT=3000
