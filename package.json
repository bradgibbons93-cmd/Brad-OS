{
  "name": "brad-os",
  "version": "0.1.0",
  "private": true,
  "description": "BRAD OS — private knowledge engine",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --disable-warning=ExperimentalWarning --watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "node --disable-warning=ExperimentalWarning tests/e2e/smoke.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "fflate": "^0.8.3",
    "hono": "^4.13.17",
    "zod": "^4.6.7",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "@vitejs/plugin-react": "^6.3.0",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.70.0",
    "marked": "^18.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "vite": "^8.3.7"
  },
  "devDependencies": {
    "vitest": "^5.1.0",
    "concurrently": "^10.0.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
